# Supabase connection — Set up in the client, safe to expose in a public app.
# Fill in from Supabase Dashboard → Project Settings → API.
#
#   VITE_SUPABASE_URL      = the "Project URL"
#   VITE_SUPABASE_ANON_KEY = the "anon public" key under Project API Keys
#
# Copy this file to `.env` and replace the values below.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
